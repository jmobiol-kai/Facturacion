<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.kai.payment.multi.branch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_kai_bridge_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="kai_bridge_move_count == 0"
                        groups="account.group_account_readonly">
                    <field name="kai_bridge_move_count" widget="statinfo" string="Asientos puente"/>
                </button>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="before">
                <field name="kai_foreign_company_count" invisible="1"/>
                <field name="kai_advance_company_candidate_ids" invisible="1"/>
                <field name="kai_advance_company_id"
                       invisible="kai_foreign_company_count &lt; 2"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('id', 'in', kai_advance_company_candidate_ids)]"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Asientos puente" name="kai_bridge_moves" invisible="kai_bridge_move_count == 0">
                    <field name="kai_bridge_move_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="company_id"/>
                            <field name="journal_id"/>
                            <field name="ref"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
