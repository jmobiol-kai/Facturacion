msgid "Cuenta corriente con sucursales"
msgstr "Cuenta corriente con sucursales"

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_res_company__kai_central_current_account_id
msgid "Cuenta corriente con casa central"
msgstr "Cuenta corriente con casa central"

#. module: kai_payment_multi_branch
#: model_terms:ir.ui.view,arch_db:kai_payment_multi_branch.view_company_form_kai_payment_multi_branch
msgid "Pagos multi-sucursal"
msgstr "Pagos multi-sucursal"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "Payment is for partner %s but payment lines are of partner %s"
msgstr "El pago es para el contacto %s pero las líneas de pago corresponden al contacto %s"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "To Pay Lines must be of the same account!"
msgstr "Líneas a Pagar deben contener la misma cuenta"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "You can't create payments for entries belonging to different companies."
msgstr "No se pueden crear pagos para asientos que pertenezcan a diferentes compañías."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"El pago multi-sucursal no puede ser menor que la deuda seleccionada "
"(facturas, notas de crédito y notas de débito). El asiento del pago cancela "
"%(payment)s y las líneas seleccionadas suman %(debt)s. Los pagos parciales "
"no están soportados entre sucursales."
msgstr ""
"El pago multi-sucursal no puede ser menor que la deuda seleccionada "
"(facturas, notas de crédito y notas de débito). El asiento del pago cancela "
"%(payment)s y las líneas seleccionadas suman %(debt)s. Los pagos parciales "
"no están soportados entre sucursales."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"Falta la cuenta corriente con sucursales en %(company)s. Configurala en "
"Ajustes de contabilidad o en la ficha de la compañía antes de confirmar el "
"pago."
msgstr ""
"Falta la cuenta corriente con sucursales en %(company)s. Configurala en "
"Ajustes de contabilidad o en la ficha de la compañía antes de confirmar el "
"pago."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"El pago de varias sucursales solo está soportado en la moneda de la compañía"
" (%(currency)s). La diferencia de cambio no se reparte entre sucursales."
msgstr ""
"El pago de varias sucursales solo está soportado en la moneda de la compañía"
" (%(currency)s). La diferencia de cambio no se reparte entre sucursales."

#. module: kai_payment_multi_branch
#: model:ir.actions.act_window,name:kai_payment_multi_branch.action_kai_payment_regularize
msgid "Regularizar pago existente"
msgstr "Regularizar pago existente"

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_kai_payment_regularize_wizard__date
msgid "Fecha de los asientos"
msgstr "Fecha de los asientos"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "El pago %(payment)s ya está regularizado."
msgstr "El pago %(payment)s ya está regularizado."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "El pago %(payment)s no concilia deuda de otra sucursal."
msgstr "El pago %(payment)s no concilia deuda de otra sucursal."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "El pago %(payment)s usa cheques. La regularización no los reparte entre sucursales."
msgstr "El pago %(payment)s usa cheques. La regularización no los reparte entre sucursales."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "El pago %(payment)s tiene retenciones. La regularización no las reparte entre sucursales."
msgstr "El pago %(payment)s tiene retenciones. La regularización no las reparte entre sucursales."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "El pago %(payment)s está en moneda extranjera. La regularización no genera la diferencia de cambio."
msgstr "El pago %(payment)s está en moneda extranjera. La regularización no genera la diferencia de cambio."

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_res_company__kai_bridge_journal_id
msgid "Diario de asientos puente"
msgstr "Diario de asientos puente"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"%(company)s no tiene el diario de operaciones misceláneas para el asiento "
"puente. Configuralo en Ajustes de contabilidad o en la ficha de la compañía. "
"No se usa el diario de punto de venta ni otro diario general."
msgstr ""
"%(company)s no tiene el diario de operaciones misceláneas para el asiento "
"puente. Configuralo en Ajustes de contabilidad o en la ficha de la compañía. "
"No se usa el diario de punto de venta ni otro diario general."

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_account_payment__kai_advance_company_id
msgid "Sucursal del anticipo"
msgstr "Sucursal del anticipo"

#. module: kai_payment_multi_branch
#: model:ir.model.fields,help:kai_payment_multi_branch.field_account_payment__kai_advance_company_id
msgid ""
"Sucursal en la que queda el excedente del pago, como anticipo abierto en la "
"cuenta a pagar o a cobrar del contacto. Si la deuda es de una sola sucursal, "
"se completa sola. Con varias sucursales hay que elegirla antes de confirmar."
msgstr ""
"Sucursal en la que queda el excedente del pago, como anticipo abierto en la "
"cuenta a pagar o a cobrar del contacto. Si la deuda es de una sola sucursal, "
"se completa sola. Con varias sucursales hay que elegirla antes de confirmar."

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_account_payment__kai_advance_company_manual_id
msgid "Sucursal del anticipo elegida"
msgstr "Sucursal del anticipo elegida"

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_account_payment__kai_foreign_company_count
msgid "Sucursales de la deuda"
msgstr "Sucursales de la deuda"

#. module: kai_payment_multi_branch
#: model:ir.model.fields,field_description:kai_payment_multi_branch.field_account_payment__kai_advance_company_candidate_ids
msgid "Sucursales para el anticipo"
msgstr "Sucursales para el anticipo"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid "Anticipo %(payment)s · %(partner)s"
msgstr "Anticipo %(payment)s · %(partner)s"

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"Indicá la sucursal del anticipo. El pago cancela %(payment)s y la deuda "
"seleccionada suma %(debt)s, así que quedan %(advance)s a cuenta. Hay deuda "
"de más de una sucursal y el excedente no se puede asignar solo."
msgstr ""
"Indicá la sucursal del anticipo. El pago cancela %(payment)s y la deuda "
"seleccionada suma %(debt)s, así que quedan %(advance)s a cuenta. Hay deuda "
"de más de una sucursal y el excedente no se puede asignar solo."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"El anticipo no puede quedar en %(company)s, que es la compañía del pago. "
"Tiene que quedar abierto en una sucursal."
msgstr ""
"El anticipo no puede quedar en %(company)s, que es la compañía del pago. "
"Tiene que quedar abierto en una sucursal."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"La sucursal del anticipo %(company)s tiene que ser de la misma entidad legal "
"que %(payer)s."
msgstr ""
"La sucursal del anticipo %(company)s tiene que ser de la misma entidad legal "
"que %(payer)s."

#. module: kai_payment_multi_branch
#. odoo-python
#: code:addons/kai_payment_multi_branch/models/account_payment.py:0
msgid ""
"Falta la cuenta a %(kind)s de %(partner)s en %(company)s para dejar el "
"anticipo."
msgstr ""
"Falta la cuenta a %(kind)s de %(partner)s en %(company)s para dejar el "
"anticipo."
