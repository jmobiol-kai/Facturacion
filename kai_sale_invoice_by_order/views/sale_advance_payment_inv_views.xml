<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_advance_payment_inv" model="ir.ui.view">
        <field name="name">sale.advance.payment.inv.form.kai.invoice.line.mode</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='consolidated_billing']" position="after">
                <field name="invoice_line_mode" widget="radio"
                       invisible="advance_payment_method != 'delivered'"/>
            </xpath>
        </field>
    </record>
</odoo>
