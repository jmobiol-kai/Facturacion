<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_vat_ledger_form_pdf" model="ir.ui.view">
        <field name="name">account.vat.ledger.form.kai.pdf</field>
        <field name="model">account.vat.ledger</field>
        <field name="inherit_id" ref="l10n_ar_reports.account_vat_ledger_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_present']" position="before">
                <button name="action_print_pdf" string="Imprimir PDF" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>
