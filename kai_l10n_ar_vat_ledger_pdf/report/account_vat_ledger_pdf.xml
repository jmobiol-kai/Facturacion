<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_vat_ledger_a4_landscape" model="report.paperformat">
        <field name="name">Libro IVA A4 apaisado</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_vat_ledger_pdf" model="ir.actions.report">
        <field name="name">Libro IVA (PDF)</field>
        <field name="model">account.vat.ledger</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kai_l10n_ar_vat_ledger_pdf.report_account_vat_ledger_pdf</field>
        <field name="report_file">kai_l10n_ar_vat_ledger_pdf.report_account_vat_ledger_pdf</field>
        <field name="print_report_name">'Libro IVA %s %s' % (object.type == 'purchase' and 'Compras' or 'Ventas', object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_vat_ledger_a4_landscape"/>
        <field name="binding_model_id" ref="l10n_ar_reports.model_account_vat_ledger"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_account_vat_ledger_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <t t-set="d" t-value="o._get_vat_ledger_pdf_data()"/>
                    <div class="page vat-ledger-pdf">
                        <style>
                            .vat-ledger-pdf { font-size: 7pt; }
                            .vat-ledger-pdf h4 { font-size: 11pt; margin: 0 0 2px 0; }
                            .vat-ledger-pdf .hdr td { padding: 0 12px 0 0; font-size: 8pt; }
                            .vat-ledger-pdf table.lines { width: 100%; border-collapse: collapse; margin-top: 6px; }
                            .vat-ledger-pdf table.lines th { background: #e9ecef; border: 1px solid #adb5bd; padding: 2px 3px; font-size: 6.5pt; text-align: center; vertical-align: middle; }
                            .vat-ledger-pdf table.lines td { border-bottom: 1px solid #dee2e6; padding: 1px 3px; white-space: nowrap; }
                            .vat-ledger-pdf table.lines td.num { text-align: right; }
                            .vat-ledger-pdf table.lines tr { page-break-inside: avoid; }
                            .vat-ledger-pdf table.lines tr.tot td { font-weight: bold; border-top: 2px solid #343a40; background: #f1f3f5; }
                            .vat-ledger-pdf table.summary { border-collapse: collapse; margin-top: 10px; }
                            .vat-ledger-pdf table.summary th, .vat-ledger-pdf table.summary td { border: 1px solid #adb5bd; padding: 2px 8px; font-size: 7.5pt; }
                            .vat-ledger-pdf table.summary td.num { text-align: right; }
                        </style>
                        <h4 t-out="d['title']"/>
                        <table class="hdr">
                            <tr>
                                <td><strong>Empresa:</strong> <span t-out="d['company_name']"/></td>
                                <td><strong>CUIT:</strong> <span t-out="d['company_cuit']"/></td>
                                <td><strong>Período:</strong> <span t-out="d['period']"/></td>
                                <td><strong>Diarios:</strong> <span t-out="d['journals']"/></td>
                                <td><strong>Comprobantes:</strong> <span t-out="d['count']"/></td>
                            </tr>
                        </table>
                        <table class="lines">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Comprobante</th>
                                    <th t-out="d['partner_label']"/>
                                    <th>CUIT</th>
                                    <t t-foreach="d['columns']" t-as="c"><th t-out="c[1]"/></t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['rows']" t-as="r">
                                    <td t-out="r['date']"/>
                                    <td t-out="r['doc_type']"/>
                                    <td t-out="r['number']"/>
                                    <td t-out="r['partner']"/>
                                    <td t-out="r['cuit']"/>
                                    <t t-foreach="r['values']" t-as="v"><td class="num" t-out="v"/></t>
                                </tr>
                                <tr class="tot">
                                    <td colspan="5">TOTALES</td>
                                    <t t-foreach="d['totals']" t-as="v"><td class="num" t-out="v"/></t>
                                </tr>
                            </tbody>
                        </table>
                        <div style="page-break-inside: avoid;">
                            <table class="summary" style="float: left; margin-right: 24px;">
                                <tr><th colspan="3">Resumen por alícuota</th></tr>
                                <tr><th>Alícuota</th><th>Neto gravado</th><th>IVA</th></tr>
                                <tr t-foreach="d['summary']" t-as="s">
                                    <td t-out="s['rate']"/>
                                    <td class="num" t-out="s['base']"/>
                                    <td class="num" t-out="s['vat']"/>
                                </tr>
                                <tr><th>Total</th><td class="num"><strong t-out="d['summary_totals']['base']"/></td><td class="num"><strong t-out="d['summary_totals']['vat']"/></td></tr>
                            </table>
                            <table class="summary">
                                <tr><th colspan="2">Otros conceptos</th></tr>
                                <tr t-foreach="d['others']" t-as="x">
                                    <td t-out="x[0]"/>
                                    <td class="num" t-out="x[1]"/>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
