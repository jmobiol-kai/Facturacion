<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_ticket" model="ir.ui.view">
        <field name="name">account.move.form.kai.invoice.ticket</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- En Odoo 19 el botón Imprimir es action_print_pdf (hay dos:
                 el destacado y el secundario). El ticket queda después del último. -->
            <xpath expr="(//header/button[@name='action_print_pdf'])[last()]" position="after">
                <button name="action_print_invoice_ticket"
                        type="object"
                        string="Ticket Factura"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or state not in ('draft', 'posted')"/>
            </xpath>
        </field>
    </record>
</odoo>
