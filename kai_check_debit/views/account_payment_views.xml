<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_kai_check_debit" model="ir.ui.view">
        <field name="name">account.payment.form.kai.check.debit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <button name="action_post" position="after">
                <button name="action_kai_debit_check"
                        string="Debitar cheque"
                        type="object"
                        class="oe_highlight"
                        groups="account.group_account_user"
                        invisible="not kai_show_check_debit_button"/>
            </button>
            <div class="oe_button_box" position="inside">
                <button name="action_open_kai_check_debit_moves"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        groups="account.group_account_readonly,account.group_account_user"
                        invisible="kai_check_debit_move_count == 0">
                    <field name="kai_check_debit_move_count" widget="statinfo" string="Débito cheque"/>
                </button>
            </div>
            <field name="payment_method_code" position="after">
                <field name="kai_show_check_debit_button" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
