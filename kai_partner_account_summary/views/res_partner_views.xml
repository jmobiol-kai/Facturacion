<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_movimientos" model="ir.ui.view">
        <field name="name">res.partner.form.movimientos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.partner_view_buttons"/>
        <field name="arch" type="xml">
            <button name="action_view_partner_invoices" position="after">
                <button type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt"
                        name="action_kai_view_account_summary"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        help="Suma de facturas, notas de crédito, recibos, cobros y pagos publicados">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="currency_id" invisible="1"/>
                            <field name="kai_total_movimientos" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </span>
                        <span class="o_stat_text">Movimientos</span>
                    </div>
                </button>
            </button>
        </field>
    </record>
</odoo>
